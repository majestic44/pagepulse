NODE_ENV=development
APP_BASE_URL=http://localhost:8080
# The owner bootstrap CLI issues one URL that expires after this many minutes (5-1440).
OWNER_SETUP_TOKEN_TTL_MINUTES=30
# Password hashing requires Node 24.7+ and uses native Argon2id. Values are memory KiB, passes, and lanes.
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_PASSES=3
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_RESET_RATE_LIMIT_MAX=3
AUTH_RESET_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REDEMPTION_RATE_LIMIT_MAX=5
AUTH_REDEMPTION_RATE_LIMIT_WINDOW_MS=3600000
# Sessions expire after 8 idle hours and always expire within 30 days. Both values are minutes.
SESSION_IDLE_TTL_MINUTES=480
SESSION_ABSOLUTE_TTL_MINUTES=43200
PUBLIC_APP_VERSION=0.0.0-dev
LOG_LEVEL=info
# Production secrets can instead use a supported <VARIABLE>_FILE path (for example,
# DATABASE_URL_FILE=/run/secrets/database_url). Never set both forms for one value.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

MARIADB_DATABASE=pagepulse
MARIADB_USER=pagepulse
MARIADB_PASSWORD=local-pagepulse-only
MARIADB_ROOT_PASSWORD=local-root-only
DATABASE_URL=mysql://pagepulse:local-pagepulse-only@mariadb:3306/pagepulse

REDIS_URL=redis://:local-redis-only@redis:6379/0
REDIS_PASSWORD=local-redis-only
QUEUE_PREFIX=pagepulse
SCHEDULER_RECONCILIATION_INTERVAL_MS=300000
# Enables the owner-only diagnostics endpoint before account authentication is implemented.
# Prefer OWNER_DIAGNOSTICS_TOKEN_FILE in production; do not set both forms.
# OWNER_DIAGNOSTICS_TOKEN=

SESSION_SECRET=replace-through-infisical
COOKIE_ENCRYPTION_KEK=replace-through-infisical
CREDENTIAL_ENCRYPTION_KEK=replace-through-infisical
TOTP_ENCRYPTION_KEK=replace-through-infisical

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=PagePulse <pagepulse@example.test>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pagepulse@example.test

SNAPSHOT_ROOT=/data/snapshots
SNAPSHOT_RETENTION_DAYS=7
CHECK_HISTORY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
DEFAULT_MEMBER_MONITOR_LIMIT=50

HTTP_FETCH_TIMEOUT_MS=15000
HTTP_FETCH_MAX_BYTES=5242880
HTTP_FETCH_CONCURRENCY=8
DOMAIN_CONCURRENCY=2
BROWSER_CONCURRENCY_MIN=1
BROWSER_CONCURRENCY_MAX=2
BROWSER_MEMORY_HIGH_WATERMARK_MB=7000
BROWSER_JOB_TIMEOUT_MS=90000
PAGEPULSE_USER_AGENT=PagePulse/0.0 (+https://example.com/pagepulse)
